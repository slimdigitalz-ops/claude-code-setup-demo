{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:types)",
      "Bash(npm run test:bun)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright install:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Read(./**)",
      "Edit(./src/**)",
      "Edit(./__tests__/**)",
      "Edit(./packages/**)",
      "Edit(./.changeset/**)",
      "Write(./.changeset/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(npm publish:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Edit(./protocol.md)",
      "Edit(./package-lock.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc -p __type-tests__/tsconfig.json --noEmit 2>&1 | tail -20"
          }
        ]
      }
    ]
  }
}
